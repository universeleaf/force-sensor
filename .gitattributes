# Preserve the bytes covered by recorded experiment SHA-256 checksums.
# CSV files may use CRLF and JSON may use LF; neither may change on checkout.
out/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
# Run records also fingerprint the exact MATLAB source bytes.
rod/*.m -text whitespace=trailing-space,space-before-tab,cr-at-eol
force.m -text whitespace=trailing-space,space-before-tab,cr-at-eol
scripts/*.py -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Keep the additional experiment protocol and report covered by figure hashes.
docs/GENERALIZATION_FIGURE_CONTRACT.md -text
docs/GENERALIZATION_RESULTS.md -text
